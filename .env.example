# ==============================================================================
# TRANSITIQ TMS — ENVIRONMENT VARIABLES CONFIGURATION TEMPLATE
# ==============================================================================

# Supabase Public Configuration
# Retrieve these from your Supabase Project Settings -> API
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.your-anon-key-here

# Supabase Private Service-Role Secret (SERVER-SIDE ONLY - NEVER EXPOSE TO CLIENT)
# Used for backend administrative migrations, seeding demo users and storage setup
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.your-service-role-key-here

# Application Base URL
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Optional AI LLM Provider Configuration
# When provided, enhances exception explanations and recommendations with generative context.
# When omitted, TransitIQ automatically utilizes its explainable deterministic rule engine.
OPENAI_API_KEY=
GEMINI_API_KEY=

# Demo User Provisioning Password (used by scripts/seed-users.ts)
DEMO_USER_PASSWORD=TransitIQ@2026!
